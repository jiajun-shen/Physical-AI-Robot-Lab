<?xml version="1.0"?>
<!--
  Phase-5 RGB-D manipulation profile.  It is a P5-only copy of the Phase-4
  RGB-D laboratory: collision geometry, seedable model names, sensor, and
  physical material are unchanged.  Each seedable static obstacle adds one
  *visual-only*, centered, high-saturation top fiducial.  A second vision-only
  localizer observes those fiducials through RGB-D/CameraInfo/TF and turns the
  observations into conservative MoveIt collision boxes.  The fiducials do
  not add a collision, joint, sensor, or pose/data transport interface.

  The scene generator still substitutes only the existing model poses.  Since
  each marker is a visual attached to its obstacle link, it moves only through
  that seeded model transform; no seed manifest or Gazebo model pose is an
  online P5 perception input.
-->
<sdf version="1.10">
  <world name="manipulation_lab">
    <physics name="one_millisecond_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_plane_link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.28 0.28 0.28 1</ambient><diffuse>0.48 0.48 0.48 1</diffuse><specular>0.01 0.01 0.01 1</specular></material></visual>
      </link>
    </model>

    <model name="work_table">
      <pose>0.65 0 0.375 0 0 0</pose><static>true</static>
      <link name="work_table_link">
        <collision name="collision"><geometry><box><size>1.0 0.9 0.75</size></box></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>1.0 0.9 0.75</size></box></geometry><material><ambient>0.28 0.18 0.08 1</ambient><diffuse>0.46 0.30 0.12 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      </link>
    </model>

    <model name="drawing_board">
      <pose>1.10 0 0.975 0 0 0</pose><static>true</static>
      <link name="drawing_board_link">
        <collision name="collision"><geometry><box><size>0.03 0.70 0.45</size></box></geometry><surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.03 0.70 0.45</size></box></geometry><material><ambient>0.78 0.78 0.75 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
    </model>

    <model name="obstacle_left">
      <pose>0.79 0.20 0.85 0 0 0</pose><static>true</static>
      <link name="obstacle_left_link">
        <collision name="collision"><geometry><box><size>0.10 0.10 0.20</size></box></geometry><surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.10 0.10 0.20</size></box></geometry><material><ambient>0.20 0.20 0.24 1</ambient><diffuse>0.32 0.32 0.38 1</diffuse><specular>0.06 0.06 0.06 1</specular></material></visual>
        <!-- Cylinder top is +0.104 m from the obstacle-link (box-centre)
             origin: 0.100 m box half-height + 0.004 m marker half-height. -->
        <visual name="p5_orange_top_fiducial">
          <pose>0 0 0.102 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><cylinder><radius>0.025</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.55 0.25 0.01 1</ambient><diffuse>1.0 0.55 0.02 1</diffuse><specular>0.01 0.01 0.01 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_right">
      <pose>0.47 0.20 0.85 0 0 -0.5</pose><static>true</static>
      <link name="obstacle_right_link">
        <collision name="collision"><geometry><box><size>0.10 0.10 0.20</size></box></geometry><surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.10 0.10 0.20</size></box></geometry><material><ambient>0.20 0.20 0.24 1</ambient><diffuse>0.32 0.32 0.38 1</diffuse><specular>0.06 0.06 0.06 1</specular></material></visual>
        <!-- Same centered geometry as the orange marker; the distinct hue
             permits one deterministic vision component per static obstacle. -->
        <visual name="p5_violet_top_fiducial">
          <pose>0 0 0.102 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><cylinder><radius>0.025</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.34 0.01 0.55 1</ambient><diffuse>0.65 0.02 1.0 1</diffuse><specular>0.01 0.01 0.01 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="green_ball">
      <pose>0.79 0 0.785 0 0 -1.2</pose><static>false</static>
      <link name="green_ball_link">
        <inertial><mass>0.065</mass><inertia><ixx>0.00003185</ixx><iyy>0.00003185</iyy><izz>0.00003185</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry><surface><friction><ode><mu>0.55</mu><mu2>0.55</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><sphere><radius>0.035</radius></sphere></geometry><material><ambient>0.03 0.45 0.09 1</ambient><diffuse>0.05 0.75 0.15 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      </link>
    </model>

    <model name="red_ball">
      <pose>0.47 0 0.785 0 0 -1.2</pose><static>false</static>
      <link name="red_ball_link">
        <inertial><mass>0.065</mass><inertia><ixx>0.00003185</ixx><iyy>0.00003185</iyy><izz>0.00003185</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry><surface><friction><ode><mu>0.55</mu><mu2>0.55</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><sphere><radius>0.035</radius></sphere></geometry><material><ambient>0.48 0.03 0.03 1</ambient><diffuse>0.80 0.05 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      </link>
    </model>

    <model name="blue_cube">
      <pose>0.63 -0.20 0.78 0 0 -0.25</pose><static>false</static>
      <link name="blue_cube_link">
        <inertial><mass>0.080</mass><inertia><ixx>0.000048</ixx><iyy>0.000048</iyy><izz>0.000048</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.06 0.06 0.06</size></box></geometry><surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.06 0.06 0.06</size></box></geometry><material><ambient>0.03 0.15 0.52 1</ambient><diffuse>0.05 0.25 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      </link>
    </model>

    <model name="yellow_cube">
      <pose>0.47 -0.20 0.78 0 0 -0.75</pose><static>false</static>
      <link name="yellow_cube_link">
        <inertial><mass>0.080</mass><inertia><ixx>0.000048</ixx><iyy>0.000048</iyy><izz>0.000048</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.06 0.06 0.06</size></box></geometry><surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.06 0.06 0.06</size></box></geometry><material><ambient>0.58 0.47 0.03 1</ambient><diffuse>0.95 0.80 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      </link>
    </model>

    <model name="lab_rgbd_camera">
      <!-- Local +X looks from the table side toward the board. -->
      <pose>0.80 -1.45 2.40 0 0.833 1.674</pose><static>true</static>
      <link name="lab_camera_link">
        <sensor name="lab_rgbd" type="rgbd_camera">
          <always_on>1</always_on><update_rate>15</update_rate><visualize>false</visualize>
          <topic>/lab_camera</topic>
          <camera>
            <horizontal_fov>1.2217304764</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>4.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- P5's second RGB-D observer is visual-only. It is deliberately a
         separate static camera rather than a world-state sensor: the online
         skill still receives only typed RGB-D/CameraInfo/TF localization.
         Its +Y viewpoint sees through the occlusion created when the arm
         approaches from the primary camera side. -->
    <model name="phase5_guard_rgbd_camera">
      <pose>0.80 1.45 2.40 0 0.833 -1.674</pose><static>true</static>
      <link name="phase5_guard_camera_link">
        <sensor name="phase5_guard_rgbd" type="rgbd_camera">
          <always_on>1</always_on><update_rate>15</update_rate><visualize>false</visualize>
          <topic>/phase5_guard_camera</topic>
          <camera>
            <horizontal_fov>1.2217304764</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>4.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- This P5-only diagonal RGB-D camera views the work area from the
         opposite X side of the +Y guard. It avoids the side-grasp wrist and
         base occlusion while covering both pick and placement workspaces,
         without changing the sealed Phase-4 camera. Like the guard camera it
         has no collision geometry and publishes only RGB-D/CameraInfo. -->
    <model name="phase5_transport_rgbd_camera">
      <pose>0.20 1.45 2.40 0 0.863 -1.156</pose><static>true</static>
      <link name="phase5_transport_camera_link">
        <sensor name="phase5_transport_rgbd" type="rgbd_camera">
          <always_on>1</always_on><update_rate>15</update_rate><visualize>false</visualize>
          <topic>/phase5_transport_camera</topic>
          <camera>
            <horizontal_fov>1.2217304764</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>4.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- The third P5-only RGB-D observer is on the opposite diagonal. It
         covers the low-X pick workspace when the side grasp hides the ball
         from the two +Y cameras. It publishes only RGB-D/CameraInfo. -->
    <model name="phase5_lift_rgbd_camera">
      <pose>1.20 -1.35 2.40 0 0.840 1.958</pose><static>true</static>
      <link name="phase5_lift_camera_link">
        <sensor name="phase5_lift_rgbd" type="rgbd_camera">
          <always_on>1</always_on><update_rate>15</update_rate><visualize>false</visualize>
          <topic>/phase5_lift_camera</topic>
          <camera>
            <horizontal_fov>1.2217304764</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>4.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
