<?xml version="1.0"?>
<package format="3">
  <name>abb_lab_gazebo</name>
  <version>0.1.0</version>
  <description>
    Minimal headless Gazebo Harmonic runtime for the simulation-only ABB
    IRB1200-5/0.9 control slice in Physical-AI-Robot-Lab.
  </description>
  <maintainer email="maintainers@example.invalid">Physical-AI-Robot-Lab maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>abb_lab_control</exec_depend>
  <exec_depend>abb_lab_description</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <architecture_independent/>
  </export>
</package>
