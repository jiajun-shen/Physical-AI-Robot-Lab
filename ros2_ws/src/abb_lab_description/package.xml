<?xml version="1.0"?>
<package format="3">
  <name>abb_lab_description</name>
  <version>0.1.0</version>
  <description>
    Geometry-only ABB IRB1200-5/0.9 description for Physical-AI-Robot-Lab.
    Gazebo, ros2_control, MoveIt, and real-hardware integration are intentionally excluded.
  </description>
  <maintainer email="maintainers@example.invalid">Physical-AI-Robot-Lab maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <architecture_independent/>
  </export>
</package>
