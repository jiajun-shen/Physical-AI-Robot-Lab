<?xml version="1.0"?>
<package format="3">
  <name>abb_lab_description</name>
  <version>0.2.0</version>
  <description>
    Pinned ABB IRB1200-5/0.9 geometry and pre-runtime Gazebo Harmonic
    ros2_control description for Physical-AI-Robot-Lab. Controllers, motion,
    MoveIt, and real-hardware integration are intentionally excluded.
  </description>
  <maintainer email="maintainers@example.invalid">Physical-AI-Robot-Lab maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>urdf</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <architecture_independent/>
    <gazebo_ros gazebo_model_path="${prefix}/../"/>
  </export>
</package>
