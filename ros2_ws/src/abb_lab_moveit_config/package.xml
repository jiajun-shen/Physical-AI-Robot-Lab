<?xml version="1.0"?>
<package format="3">
  <name>abb_lab_moveit_config</name>
  <version>0.1.0</version>
  <description>
    Project-owned, arm-only MoveIt configuration contract for the ABB
    IRB1200-5/0.9 simulation model. This package contains no simulator launch
    and does not establish planning or execution acceptance evidence.
  </description>
  <maintainer email="maintainers@example.invalid">Physical-AI-Robot-Lab maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>abb_lab_control</exec_depend>
  <exec_depend>abb_lab_description</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>abb_lab_control</test_depend>
  <test_depend>abb_lab_description</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>moveit_configs_utils</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <architecture_independent/>
  </export>
</package>
