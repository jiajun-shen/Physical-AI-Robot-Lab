<?xml version="1.0"?>
<!--
  Phase-6-only ABB/gripper description with a lightweight drawing pen.
  The pen is a fixed, collision-bearing extension of gripper_tcp; it changes
  neither the ros2_control interfaces nor the controller ownership model.
  It exists in both the spawned Gazebo robot and MoveIt's robot description,
  so drawing_tip is an actual simulated tool frame rather than a projected
  world-space point.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="abb_irb1200_5_90_gz_gripper_control">
  <xacro:include filename="$(find abb_lab_gripper)/urdf/irb1200_5_90_gz_gripper_control.urdf.xacro"/>

  <xacro:property name="drawing_pen_length_m" value="0.085"/>
  <xacro:property name="drawing_pen_radius_m" value="0.004"/>

  <link name="drawing_pen_shaft">
    <inertial>
      <origin xyz="${drawing_pen_length_m / 2.0} 0 0" rpy="0 0 0"/>
      <mass value="0.018"/>
      <inertia ixx="0.0000001" ixy="0" ixz="0" iyy="0.000011" iyz="0" izz="0.000011"/>
    </inertial>
    <visual>
      <origin xyz="${drawing_pen_length_m / 2.0} 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="${drawing_pen_radius_m}" length="${drawing_pen_length_m}"/></geometry>
      <material name="drawing_pen_dark"><color rgba="0.12 0.12 0.14 1"/></material>
    </visual>
    <collision>
      <origin xyz="${drawing_pen_length_m / 2.0} 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="${drawing_pen_radius_m}" length="${drawing_pen_length_m}"/></geometry>
    </collision>
  </link>
  <joint name="gripper_tcp_to_drawing_pen_shaft" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_tcp"/>
    <child link="drawing_pen_shaft"/>
  </joint>
  <link name="drawing_tip"/>
  <joint name="drawing_pen_shaft_to_drawing_tip" type="fixed">
    <origin xyz="${drawing_pen_length_m} 0 0" rpy="0 0 0"/>
    <parent link="drawing_pen_shaft"/>
    <child link="drawing_tip"/>
  </joint>
</robot>
