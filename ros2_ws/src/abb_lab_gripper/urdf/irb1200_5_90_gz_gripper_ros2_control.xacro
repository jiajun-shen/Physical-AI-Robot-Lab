<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Keep all seven commanded joints in one GazeboSimSystem. The opposite
       gripper finger exports state only: it is a URDF mimic follower, not a
       second command target. -->
  <xacro:macro name="abb_irb1200_5_90_gz_gripper_ros2_control" params="name prefix arm_joint_limits gripper_joint_limits gripper_initial_positions">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="${prefix}joint_1">
        <command_interface name="position">
          <param name="min">${arm_joint_limits['joint_1']['min_position']}</param>
          <param name="max">${arm_joint_limits['joint_1']['max_position']}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_2">
        <command_interface name="position">
          <param name="min">${arm_joint_limits['joint_2']['min_position']}</param>
          <param name="max">${arm_joint_limits['joint_2']['max_position']}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_3">
        <command_interface name="position">
          <param name="min">${arm_joint_limits['joint_3']['min_position']}</param>
          <param name="max">${arm_joint_limits['joint_3']['max_position']}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_4">
        <command_interface name="position">
          <param name="min">${arm_joint_limits['joint_4']['min_position']}</param>
          <param name="max">${arm_joint_limits['joint_4']['max_position']}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_5">
        <command_interface name="position">
          <param name="min">${arm_joint_limits['joint_5']['min_position']}</param>
          <param name="max">${arm_joint_limits['joint_5']['max_position']}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_6">
        <command_interface name="position">
          <param name="min">${arm_joint_limits['joint_6']['min_position']}</param>
          <param name="max">${arm_joint_limits['joint_6']['max_position']}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}two_finger_right_joint">
        <command_interface name="position">
          <param name="min">${gripper_joint_limits['two_finger_right_joint']['min_position']}</param>
          <param name="max">${gripper_joint_limits['two_finger_right_joint']['max_position']}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${gripper_initial_positions['two_finger_right_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}two_finger_left_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
